    "managed:deposit": "ts-node src/cli.ts managed:deposit",
    "managed:withdraw": "ts-node src/cli.ts managed:withdraw",
    "managed:withdraw-shares": "ts-node src/cli.ts managed:withdraw-shares",
    "managed:withdraw-complete": "ts-node src/cli.ts managed:withdraw-complete",
    "managed:withdraw-reject": "ts-node src/cli.ts managed:withdraw-reject",
