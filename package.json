{
  "name": "agentic-wallet",
  "version": "1.0.0",
  "description": "Agentic wallets for AI agents (Solana devnet prototype)",
  "main": "dist/index.js",
  "scripts": {
    "cli": "ts-node src/cli.ts",
    "dev": "ts-node src/cli.ts",
    "api:server": "ts-node src/api/server.ts",
    "demo:step3": "ts-node src/cli.ts step3",
    "demo:step4": "ts-node src/cli.ts step4",
    "demo:step5": "ts-node src/cli.ts step5",
    "demo:step6": "ts-node src/cli.ts step6",
    "x402:server": "ts-node src/addons/x402/server.ts",
    "x402:client": "ts-node src/cli.ts x402:client",
    "dash:api": "ts-node src/addons/dashboard-api/server.ts",
    "dash:ui": "cd dashboard && npm run dev",
    "dash": "npm run dash:api",
    "deposit": "ts-node src/cli.ts vault:deposit",
    "withdraw": "ts-node src/cli.ts vault:withdraw",
    "managed:overview": "ts-node src/cli.ts managed:overview",
    "managed:positions": "ts-node src/cli.ts managed:positions",
    "managed:trades": "ts-node src/cli.ts managed:trades",
